{
  "name": "devcore",
  "productName": "DevCore",
  "version": "1.0.2",
  "description": "DevCore - A lightweight developer workspace with intelligent slash commands",
  "main": "bootstrap.js",
  "author": "DevCore",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "monaco-editor": "^0.50.0"
  },
  "build": {
    "appId": "com.devcore.app",
    "productName": "DevCore",
    "compression": "maximum",
    "files": [
      "main.js",
      "bootstrap.js",
      "preload.js",
      "app.js",
      "commands.js",
      "index.html",
      "style.css",
      "lazy-monaco.js",
      "icon.ico",
      "installer.nsh",
      "node_modules/monaco-editor/min/vs/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevCore"
    }
  }
}
